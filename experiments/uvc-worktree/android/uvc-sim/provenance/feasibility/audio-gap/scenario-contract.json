    "event_order": "Schedule array order is the deterministic delivery order; blocked workers advance only on explicit release events.",
    "driver_control": "Synthetic request-stop/drain/release actors; timeout is an observation, not proof of physical closure.",
    "origin_oracle": "Fixture-only truth. Android APIs do not expose per-PCM-frame physical origin with the atomicity assumed by an oracle.",
    "health": "read>0, file growth, preferred-device success and not-silenced are insufficient on their own.",
    "projection": "Assertions address admission, ownership, evidence and existing affected-stream behavior; do not add UI states, modes or acceptance IDs."
  },
  "predicates": {
    "no_default_input_request": "No request selecting null/default/built-in input as fallback.",
    "no_accepted_pcm": "No PCM token reaches the committed/recognized evidence sink for the specified tokens or scope.",
    "accepted_tokens": "Exact synthetic token set accepted after all fixture admission evidence is present; no hardware claim.",
    "invalidated_before_stop_io": "Admission token invalidation precedes a possibly blocked driver stop.",
    "stale_generation_rejected": "Frames/control callbacks tagged with an old lease cannot publish or alter a newer lease.",
    "stop_scope": "Only scopes actually mapped to the failed input are automatically interrupted.",
    "unaffected_scope_not_auto_stopped": "Source-specific failure alone does not stop independent healthy scopes.",
    "no_auto_restart": "Attach, permission grant, unmute or late callbacks alone cannot reopen input.",
    "explicit_reselect_after_drain": "Fresh admission requires explicit user selection plus prior operation drain and current permission/evidence.",
    "physical_close_not_claimed": "Do not claim device closure/release completed while the synthetic driver remains blocked.",
    "release_attempts": "Each synthetic handle gets at most one release attempt; a timeout does not invent successful completion.",
    "health_not_promoted": "Do not infer verified audio health from the listed insufficient signals.",
    "route_window_evidence_insufficient": "Indistinguishable public observations with different oracle origins cannot prove zero unintended-origin samples.",
    "bidirectional_claim": "Whether C and D coverage supports a bidirectional claim; G2 acceptance is still false.",
    "mute_not_substituted": "One mute/stop action is not evidence that the other two controls or all four physical paths are affected.",
    "format_change_not_reinterpreted": "Previously buffered PCM retains its original rate/channel/timing attribution; do not relabel under new settings.",
    "uncertainty_retained": "Missing/contradictory route or source evidence remains unknown rather than being filled from another path."
