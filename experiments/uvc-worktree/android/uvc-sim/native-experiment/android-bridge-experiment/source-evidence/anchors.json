    {
      "id": "usb-result-fill-in",
      "kind": "source_fact",
      "statement": "Immediate results and the SystemUI dialog pass device/grant extras in a new Intent to PendingIntent.send.",
      "refs": [
        {
          "source_id": "UsbUserPermissionManager",
          "start_line": 716,
          "end_line": 743,
          "contains": [
            "Intent intent = new Intent();",
            "pi.send(mContext, 0, intent);"
          ]
        },
        {
          "source_id": "UsbDialogHelper",
          "start_line": 243,
          "end_line": 255,
          "contains": [
            "intent.putExtra(UsbManager.EXTRA_PERMISSION_GRANTED, permissionGranted);",
            "mPendingIntent.send(mContext, 0, intent);"
          ]
        }
      ]
    },
    {
      "id": "immutable-drops-fill-in",
      "kind": "source_fact",
      "statement": "PendingIntentRecord merges the supplied Intent only without FLAG_IMMUTABLE; an immutable PI loses these newly supplied result extras.",
      "refs": [
        {
          "source_id": "PendingIntentRecord",
          "start_line": 486,
          "end_line": 503,
          "contains": [
            "if (!immutable) {",
            "finalIntent.fillIn(intent, key.flags);"
          ]
        }
      ]
    },
